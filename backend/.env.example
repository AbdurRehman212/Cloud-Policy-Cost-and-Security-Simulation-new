# Copy to backend/.env (git-ignored) and replace every placeholder. Never commit real values.
FLASK_ENV=development
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost/cloud_simulator
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">
JWT_SECRET_KEY=<generate a different random value>
PORT=5000
# Optional
# TEST_DATABASE_URL=postgresql://<db_user>:<db_password>@localhost/cloud_simulator_test
# ALLOW_SYSTEM_RESET=false
# FRONTEND_BASE_URL=http://localhost:3000   # used in e-mailed links (never taken from the request)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# EMAIL_VERIFICATION_REQUIRED=false
# MAIL_SERVER=<smtp host>
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_DEFAULT_SENDER=<noreply address>
# MAIL_USERNAME=<smtp user>
# MAIL_PASSWORD=<smtp password>
